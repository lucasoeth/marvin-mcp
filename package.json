{
  "name": "marvin-mcp",
  "version": "1.0.0",
  "description": "MCP server for Amazing Marvin todo app",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "marvin-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote-server.js",
    "dev": "tsc --watch",
    "dev:remote": "tsc && node dist/remote-server.js"
  },
  "keywords": [
    "mcp",
    "amazing-marvin",
    "todo",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.3.0"
  }
}
