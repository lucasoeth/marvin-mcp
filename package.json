{
  "name": "marvin-mcp",
  "version": "2.0.1",
  "description": "Amazing Marvin as a CLI and an MCP server",
  "type": "module",
  "main": "dist/bin/marvin.js",
  "bin": {
    "marvin": "./dist/bin/marvin.js",
    "marvin-mcp": "./dist/bin/marvin-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overridesReason": "@hono/node-server is pinned forward for GHSA-frvp-7c67-39w9. See AGENTS.md > Dependency notes.",
  "overrides": {
    "@hono/node-server": "^2.0.12"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasoeth/marvin-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "marvin": "node dist/bin/marvin.js",
    "mcp": "node dist/bin/marvin-mcp.js",
    "mcp:remote": "node dist/bin/marvin-mcp-remote.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amazing-marvin",
    "todo",
    "task-management",
    "productivity",
    "cli",
    "claude"
  ],
  "homepage": "https://github.com/lucasoeth/marvin-mcp#readme",
  "bugs": {
    "url": "https://github.com/lucasoeth/marvin-mcp/issues"
  },
  "author": "Lucas Soeth",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
