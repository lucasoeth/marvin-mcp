{
  "name": "marvin-mcp",
  "version": "2.0.0",
  "description": "MCP server for Amazing Marvin todo app",
  "type": "module",
  "main": "dist/bin/marvin.js",
  "bin": {
    "marvin": "./dist/bin/marvin.js",
    "marvin-mcp": "./dist/bin/marvin-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "marvin": "node dist/bin/marvin.js",
    "mcp": "node dist/bin/marvin-mcp.js",
    "mcp:remote": "node dist/bin/marvin-mcp-remote.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "amazing-marvin",
    "todo",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
