# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
# Use "*" for development, or specify allowed origins separated by commas
ALLOWED_ORIGINS=*

# Admin Secret (for creating authentication tokens)
# Generate a secure random string for production
ADMIN_SECRET=your-secure-admin-secret-here

# For local development with stdio mode (optional)
# MARVIN_API_TOKEN=your-marvin-api-token
# MARVIN_FULL_ACCESS_TOKEN=your-marvin-full-access-token
