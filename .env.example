# All six are required, and all six come from one page:
# Amazing Marvin > Settings > API  (https://app.amazingmarvin.com/pre?api)
#
# Normally you would not use this file at all — `marvin auth` saves these to
# ~/.marvin/config.json at 0600, which works from any directory. This exists for
# development and for deployments that inject configuration as environment
# variables. The environment wins over the config file.

# Two tokens, from the top of the settings page. Both end in "=".
MARVIN_API_TOKEN=
MARVIN_FULL_ACCESS_TOKEN=

# Sync database, further down that same page.
#
# Reads go here. Marvin's public API has no search endpoint and cannot return
# completed tasks at all, so the alternative was crawling the container tree at
# ~22 requests per search against a 1440/day budget that Marvin enforces by
# restricting accounts rather than returning errors. This is one query instead.
#
# Read-only. Every write goes through the public API, which owns conflict
# resolution and the side effects that writing documents directly would bypass.
MARVIN_SYNC_SERVER=
MARVIN_SYNC_DATABASE=
MARVIN_SYNC_USER=
MARVIN_SYNC_PASSWORD=

# Remote MCP server only (npm run mcp:remote). That server refuses to start
# without it, since it is internet-reachable and holds write access to your
# tasks. Clients send `Authorization: Bearer <API_KEY>`; a ?token= query
# parameter also works for clients that cannot set headers, but prefer the
# header — keys in URLs leak into access and proxy logs.
API_KEY=
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*
