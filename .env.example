# Required. Amazing Marvin > Settings > API
MARVIN_API_TOKEN=
MARVIN_FULL_ACCESS_TOKEN=

# Optional: direct CouchDB/Cloudant access.
#
# From the same settings page (app.amazingmarvin.com/pre?api), further down.
# This is the only route to a `_changes` feed. The public API has no
# invalidation primitive of any kind: no ETags, no conditional requests, no
# since-params, and it does not even maintain updatedAt on its own writes.
#
# With these set, the client can follow a changes cursor instead of crawling the
# container tree, which would make `find` instant and remove the rate-limit
# pressure. Without them everything still works; reads just cost more.
#
# Caveats: Marvin's docs say the 1440/day rate limit applies to direct database
# access too, and direct access means owning conflict resolution yourself.
MARVIN_SYNC_SERVER=
MARVIN_SYNC_DATABASE=
MARVIN_SYNC_USER=
MARVIN_SYNC_PASSWORD=

# Remote MCP server only (npm run mcp:remote). Required by that server, which
# refuses to start without one since it is internet-reachable and holds write
# access to your tasks. Clients authenticate with ?token=<API_KEY>
API_KEY=
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*
