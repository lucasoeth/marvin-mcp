# Marvin API Credentials (Required)
MARVIN_API_TOKEN=your-marvin-api-token
MARVIN_FULL_ACCESS_TOKEN=your-marvin-full-access-token

# API Key (Optional - for authentication)
# If set, clients must provide this key to access the server
# Leave empty to allow unauthenticated access
API_KEY=your-secure-api-key-here

# Server Configuration (Optional)
PORT=3000
NODE_ENV=production

# CORS Configuration (Optional)
# Use "*" for development, or specify allowed origins separated by commas
ALLOWED_ORIGINS=*
